# Microsoft Entra ID (single-tenant, public client — žiadny secret)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# SharePoint (Microsoft Graph)
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ZAKAZKY_ID=
SHAREPOINT_LIST_OBJEDNAVKY_ID=
SHAREPOINT_LIST_ZAZNAMY_ID=
SHAREPOINT_LIST_UKONY_ID=
SHAREPOINT_LIST_VOZIDLA_ID=
SHAREPOINT_LIST_REZERVACIE_ID=
# Dochádzka — ak chýba, appka nájde zoznam podľa názvu a ID vypíše do konzoly.
SHAREPOINT_LIST_DOCHADZKA_UDALOSTI_ID=
SHAREPOINT_LIST_DOCHADZKA_NFC_TAGY_ID=
SHAREPOINT_LIST_DOCHADZKA_OPRAVNENIA_ID=
SHAREPOINT_LIST_DOCHADZKA_ZIADOSTI_ID=

# Tieto premenné sa pri EAS Build načítajú z EAS Environment (preview / production).
# Lokálne: skopírujte tento súbor na .env a vyplňte hodnoty.
